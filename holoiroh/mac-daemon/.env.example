# Copy to `.env` (gitignored) and fill in real values. Loaded by `dotenvy::dotenv()` in
# main.rs at startup -- see that call site's doc comment for the exact precedence
# (local .env, then ~/.holo/.env, then process env var).

# H Company Inference API key. Powers the primary hosted backend when no local model is
# running (see local_model.rs's module doc for the alpha's no-cloud local-model mode, which
# does not need this set at all).
HAI_API_KEY=

# Tinfoil confidential-computing inference key (https://tinfoil.sh). Powers:
#   - tinfoil_proxy.rs: rate-limit fallback to kimi-k2-6 when the H Company backend 429s
#   - clarify.rs: clarifying-questions inference
#   - tinfoil_documents.rs / tinfoil_vision.rs / tinfoil_audio.rs / tinfoil_planner.rs:
#     document processing, image analysis, audio transcription/TTS, and agentic tool-calling
# Every one of the above is independently optional -- leaving this unset simply disables
# each feature (logged, never a startup failure).
TINFOIL_API_KEY=
